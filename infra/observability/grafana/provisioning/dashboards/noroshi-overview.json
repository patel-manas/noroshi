      "title": "Deduplicated Alerts",
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(noroshi_alerts_received_total{deduplicated=\"true\"}) or vector(0)",
          "refId": "A"
        }
      ]
